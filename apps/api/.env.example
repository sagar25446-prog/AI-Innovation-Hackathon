# GuruFlow teacher brain configuration.
# Every value is optional. With none of them set the app still runs the full
# lesson, generates teaching videos and speaks - it just does so deterministically.

# Comma-separated CORS origins. Defaults to * for local demos.
GURUFLOW_CORS_ORIGINS=*

# --- LLM (optional) --------------------------------------------------------
# Gemini Flash for richer lesson planning, semantic answer evaluation and
# follow-up answers. Free key: https://aistudio.google.com/apikey
# Without it the planner and evaluator use the deterministic rule-based path.
GEMINI_API_KEY=
# GURUFLOW_GEMINI_MODEL=gemini-2.5-flash

# --- Teaching video --------------------------------------------------------
# Rendered locally with Manim + edge-tts + ffmpeg. No key, no cloud.
# Quality: low (854x480@15) | medium (1280x720@30, default) | high (1920x1080@60)
GURUFLOW_VIDEO_QUALITY=medium
# Where rendered videos are cached. Defaults to a temp directory; these are
# regenerable artefacts and are deliberately not committed.
# GURUFLOW_VIDEO_CACHE=

# --- Vector RAG (optional) -------------------------------------------------
# Needs apps/api/requirements-vector.txt, which requires a C++ toolchain on
# Windows. The default keyword retrieval is what the test suite covers.
GURUFLOW_VECTOR_RAG=0

# --- Optional photoreal talking head (off by default) ----------------------
# Lip-syncs a still teacher portrait into the lesson's teacher panel using
# SadTalker. Runs in ~4-6GB VRAM at crop/256. See docs/TALKING_HEAD_SETUP.md.
#
# USE A FACE YOU HAVE RIGHTS TO: a synthetic portrait, a licensed stock
# portrait, or someone who has consented. Not a photo of a real person who
# has not agreed.
GURUFLOW_TALKING_HEAD=0
# GURUFLOW_SADTALKER_DIR=C:\path\to\SadTalker
# Must be the sadtalker conda env's interpreter, not the API's.
# GURUFLOW_SADTALKER_PYTHON=C:\Users\you\miniconda3\envs\sadtalker\python.exe
# A STILL IMAGE (png/jpg), not a video - SadTalker generates the motion.
# GURUFLOW_TEACHER_PORTRAIT=C:\path\to\teacher.png
#
# Tuning. Defaults are the low-VRAM configuration for a 6GB card.
# Mouth openness; raise toward 1.3 if lips look under-articulated.
# GURUFLOW_SADTALKER_EXPRESSION=1.0
# Suppress head sway so the face does not drift inside the panel.
# GURUFLOW_SADTALKER_STILL=1
# "crop" is the low-VRAM path; "full" needs more and the panel crops it anyway.
# GURUFLOW_SADTALKER_PREPROCESS=crop
# 512 doubles VRAM and time for detail a ~248px panel cannot show.
# GURUFLOW_SADTALKER_SIZE=256
# GFPGAN roughly doubles VRAM and runtime. Leave off on 6GB.
# GURUFLOW_SADTALKER_ENHANCER=
# SadTalker generates rather than inpaints, so renders take minutes.
# GURUFLOW_TALKING_HEAD_TIMEOUT=1800

# --- Voice -----------------------------------------------------------------
# The teacher is female by default (hi-IN-SwaraNeural / en-IN-NeerjaNeural).
# Override per language:
# GURUFLOW_VOICE_HINGLISH=hi-IN-SwaraNeural
# GURUFLOW_VOICE_HINDI=hi-IN-SwaraNeural
# GURUFLOW_VOICE_ENGLISH=en-IN-NeerjaNeural

# --- Optional cloud avatar (not used by default) ---------------------------
# GuruFlow renders its own teaching video, so this is an alternative rather
# than a dependency. services/media/src/did-avatar-provider.js reads this key
# when the media library is driven from a Node process; the browser client
# does not use it.
DID_API_KEY=
