# GuruFlow teacher brain configuration.
# Every value is optional: the demo path runs fully deterministic with no keys.

# Comma-separated CORS origins. Defaults to * for local demos.
GURUFLOW_CORS_ORIGINS=*

# Gemini Flash API key for LLM-powered planning and evaluation.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use (default: gemini-2.5-flash).
# GURUFLOW_GEMINI_MODEL=gemini-2.5-flash

# Enable full vector RAG (sentence-transformers + ChromaDB persistent index).
# Set to 1 to engage semantic retrieval with page-cited sections; the fast
# keyword path is the default for tests and the core demo.
GURUFLOW_VECTOR_RAG=0

# Optional provider adapters. Leave blank to use the deterministic mock
# providers and the polished fallback teacher panel.
GURUFLOW_TTS_API_KEY=
GURUFLOW_AVATAR_API_KEY=
GURUFLOW_LLM_API_KEY=
