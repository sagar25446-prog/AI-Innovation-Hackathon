# GuruFlow teacher brain configuration.
# Every value is optional. With none of them set the app still runs the full
# lesson, generates teaching videos and speaks - it just does so deterministically.

# Comma-separated CORS origins. Defaults to * for local demos.
GURUFLOW_CORS_ORIGINS=*

# --- LLM (optional) --------------------------------------------------------
# Gemini Flash for richer lesson planning, semantic answer evaluation and
# follow-up answers. Free key: https://aistudio.google.com/apikey
# Without it the planner and evaluator use the deterministic rule-based path.
GEMINI_API_KEY=
# GURUFLOW_GEMINI_MODEL=gemini-2.5-flash

# --- Teaching video --------------------------------------------------------
# Rendered locally with Manim + edge-tts + ffmpeg. No key, no cloud.
# Quality: low (854x480@15) | medium (1280x720@30, default) | high (1920x1080@60)
GURUFLOW_VIDEO_QUALITY=medium
# Where rendered videos are cached. Defaults to a temp directory; these are
# regenerable artefacts and are deliberately not committed.
# GURUFLOW_VIDEO_CACHE=

# --- Vector RAG (optional) -------------------------------------------------
# Needs apps/api/requirements-vector.txt, which requires a C++ toolchain on
# Windows. The default keyword retrieval is what the test suite covers.
GURUFLOW_VECTOR_RAG=0

# --- Optional cloud avatar (not used by default) ---------------------------
# GuruFlow renders its own teaching video, so this is an alternative rather
# than a dependency. services/media/src/did-avatar-provider.js reads this key
# when the media library is driven from a Node process; the browser client
# does not use it.
DID_API_KEY=
