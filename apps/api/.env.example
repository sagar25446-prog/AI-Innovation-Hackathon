# GuruFlow teacher brain configuration.
# Every value is optional: the demo path runs fully deterministic with no keys.

# Comma-separated CORS origins. Defaults to * for local demos.
GURUFLOW_CORS_ORIGINS=*

# Optional provider adapters. Leave blank to use the deterministic mock
# providers and the polished fallback teacher panel.
GURUFLOW_TTS_API_KEY=
GURUFLOW_AVATAR_API_KEY=
GURUFLOW_LLM_API_KEY=
